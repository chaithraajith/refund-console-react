# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file is read automatically when you run `npm start`.
# NEVER commit your real .env to git — it is already in .gitignore.

# Your store's myshopify domain (NOT the custom domain internetfinds.in).
# Find it under Settings -> Domains; it looks like internetfinds.myshopify.com
SHOPIFY_STORE=your-store.myshopify.com

# ----------------------------------------------------------------------------
# CHOOSE ONE AUTH METHOD:
# ----------------------------------------------------------------------------

# METHOD A — Dev Dashboard app (this is your "Refund" app).
# The Dev Dashboard does NOT give a one-click shpat_ token. Instead the server
# exchanges the app's Client ID + Client Secret for a token automatically and
# refreshes it (these tokens expire ~24h, which the server handles for you).
# Get both from the app in the Dev Dashboard -> Settings / API credentials.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret

# METHOD B — Legacy custom app (only if you still use one). If this is set it
# takes priority and the client id/secret above are ignored.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The app must have scopes: read_orders, write_orders.

# Optional: server port (defaults to 3000).
# PORT=3000
